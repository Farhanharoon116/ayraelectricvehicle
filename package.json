{
  "name": "aev-management-system",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "db:generate": "pnpm --filter @aev/api db:generate",
    "db:migrate:local": "pnpm --filter @aev/api db:migrate:local",
    "db:seed:local": "pnpm --filter @aev/api db:seed:local"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
